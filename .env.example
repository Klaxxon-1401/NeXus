# ---------------------------------------------------------------------------
# Sigma Investments — environment template
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Flask runtime mode: development | testing | demo | production
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production requires at least 32 characters.
SECRET_KEY=dev-only-change-this-secret-key

# SQLite is the local default when DATABASE_URL is empty.
# PostgreSQL example:
# DATABASE_URL=postgresql://sigma:password@localhost:5432/sigma
DATABASE_URL=

# Demo-only simulation endpoints (deposit confirmation, withdrawal review,
# early return settlement). MUST be false in production.
DEMO_MODE=true
DEMO_PASSWORD=SigmaDemo!2026

# Session lifetime in hours.
SESSION_HOURS=8
# Set true behind HTTPS. Production forces this to true.
SESSION_COOKIE_SECURE=false

# Honor X-Forwarded-* headers. Enable only behind a proxy that overwrites them.
# Production requires this to be true.
TRUST_PROXY_HEADERS=false
FORCE_HTTPS=false

# Rate limiting. Use Redis in production, e.g. redis://localhost:6379/0
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per hour

# Support address shown in the UI.
SUPPORT_EMAIL=desk@sigma.example

# Illustrative treasury addresses. Replace with provider-issued addresses.
DEPOSIT_ADDRESS_ETHEREUM=0x71C9A0d5D6c4FfB2B5e7aE4f2D8e3C7b9A1d6F20
DEPOSIT_ADDRESS_BITCOIN=bc1qsigma0demo0address0only0000000000000000
DEPOSIT_ADDRESS_SOLANA=SigmaDemo1111111111111111111111111111111111
